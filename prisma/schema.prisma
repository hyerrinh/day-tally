// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  GOOGLE
  APPLE
}

enum SortOrder {
  NEWEST_FIRST
  OLDEST_FIRST
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authAccounts AuthAccount[]
  categories   Category[]
  actions      Action[]
  records      Record[]
  userSetting  UserSetting?
}

model AuthAccount {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  provider          Provider
  providerAccountId String
  providerEmail     String?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Category {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  name           String   @db.VarChar(15)
  normalizedName String   @db.VarChar(15)
  icon           String   @default("default")
  isHidden       Boolean  @default(false)
  sortOrder      Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  actions            Action[]
  selectedInSettings UserSetting[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedName])
  @@index([userId, isHidden, sortOrder])
}

model Action {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @db.Uuid
  categoryId             String   @db.Uuid
  name                   String   @db.VarChar(15)
  normalizedName         String   @db.VarChar(15)
  icon                   String   @default("default")
  defaultDurationMinutes Int?
  isHidden               Boolean  @default(false)
  sortOrder              Int
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  records Record[]

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([categoryId, normalizedName])
  @@index([userId, categoryId, isHidden, sortOrder])
}

model Record {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  actionId        String   @db.Uuid
  recordDate      DateTime @db.Date
  durationMinutes Int?
  memo            String?  @db.VarChar(500)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  action Action @relation(fields: [actionId], references: [id], onDelete: Restrict)

  @@index([userId, recordDate])
  @@index([userId, actionId, recordDate, createdAt])
}

model UserSetting {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @unique @db.Uuid
  recordSortOrder        SortOrder @default(NEWEST_FIRST)
  lastSelectedCategoryId String?   @db.Uuid
  timezone               String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastSelectedCategory Category? @relation(fields: [lastSelectedCategoryId], references: [id], onDelete: SetNull)
}
